rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default: deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // =====================================================
    // PLAYERS
    // =====================================================
    match /players/{playerId} {

      // Public website needs to read players
      allow read: if true;

      // Website Owner needs to add/update player information
      allow create: if true;

      allow update: if true;

      // Owner needs to delete players
      allow delete: if true;
    }

    // =====================================================
    // TEAMS
    // =====================================================
    match /teams/{teamId} {

      // Public website needs to read teams
      allow read: if true;

      // Website Owner needs to add/update teams
      allow create: if true;

      allow update: if true;

      // Owner needs to delete teams
      allow delete: if true;
    }

    // =====================================================
    // ADMINS
    // =====================================================
    match /admins/{adminUid} {

      // Admin documents are not publicly accessible
      allow read, write: if false;
    }
  }
}
